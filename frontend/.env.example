# Frontend environment template. Copy to .env
# ONLY non-secret values belong here. Never put API keys in the frontend.
VITE_API_BASE_URL=http://localhost:8000/api

# Firebase Web App configuration (public client settings only).
# Enable Google in Firebase Console > Authentication > Sign-in method.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
