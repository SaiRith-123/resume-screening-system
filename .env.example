# ---------------------------------------------------------------------------
# Intelligent Resume Screening System - environment template
# Copy to `.env` and fill in real values. NEVER commit a real `.env`.
# ---------------------------------------------------------------------------

# --- Application ---
APP_NAME="Intelligent Resume Screening System"
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api

# --- Security (change these!) ---
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# --- Database (PostgreSQL + pgvector) ---
POSTGRES_USER=rss
POSTGRES_PASSWORD=rss_password
POSTGRES_DB=resume_screening
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://rss:rss_password@localhost:5432/resume_screening

# --- Async / Celery ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
USE_CELERY=true

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Firebase Authentication ---
FIREBASE_PROJECT_ID=resume-screening-system-4da6e
# Local path to the downloaded Admin SDK JSON; never commit this file.
FIREBASE_SERVICE_ACCOUNT_FILE=./firebase-admin.json

# Public Firebase Web App settings, injected into the frontend build.
VITE_API_BASE_URL=http://localhost:8000/api
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=resume-screening-system-4da6e.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=resume-screening-system-4da6e
VITE_FIREBASE_STORAGE_BUCKET=resume-screening-system-4da6e.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=667098693087
VITE_FIREBASE_APP_ID=1:667098693087:web:8051cc3e2e55af6704586a

# --- Uploads ---
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=10
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_BACKEND=transformers
EMBEDDING_CACHE_DIR=.cache/embeddings

# --- LLM provider abstraction ---
# LLM_PROVIDER: openai | generic | local | null
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=3
# OpenAI-compatible
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Generic chat-completions-compatible endpoint
GENERIC_LLM_URL=
GENERIC_LLM_API_KEY=
# Local model (Ollama / vLLM)
LOCAL_LLM_URL=http://localhost:11434/v1/chat/completions
LOCAL_LLM_MODEL=llama3

# --- Ports (compose) ---
BACKEND_PORT=8000
FRONTEND_PORT=5173
